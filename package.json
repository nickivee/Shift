{
  "name": "shift",
  "version": "0.1.0",
  "private": true,
  "description": "SHIFT: health information flow application for the New Zealand health and disability sector. Enter once. Information moves.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
