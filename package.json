    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@noble/hashes": "1.8",
    "@types/node": "^22.18.0",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.25.12",
    "sql.js": "1.13",
    "typescript": "^5.9.0"
  }
}
